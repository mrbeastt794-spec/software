# Supabase (Project Settings > API). The service-role key is SECRET: server only, never in client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Admin login password (8+ characters). Admin page is disabled until this is set.
ADMIN_PASSWORD=
# Random string used to sign admin sessions (set it on Vercel so sessions work across instances)
ADMIN_SESSION_SECRET=
